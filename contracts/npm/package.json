{
  "name": "@taskingai/contracts",
  "version": "1.0.0",
  "description": "Shared contracts and schemas for TaskingAI (frontend). TypeScript types, constants, and JSON Schema validators for the Artifact Protocol.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/artifact/schemas/*.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "node dist/artifact/validator.test.js",
    "check-contracts": "node dist/check-contracts.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "taskingai",
    "contracts",
    "schema",
    "artifact",
    "typescript"
  ],
  "author": "TaskingAI",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0"
  }
}
