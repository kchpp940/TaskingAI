# ============================================================
# Root .dockerignore for all services
# Build context: project root
# Services use their own Dockerfile: docker build -f <service>/Dockerfile .
# ============================================================

# Git
.git
.gitignore
.github

# Editor & IDE
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
.coverage
htmlcov/

# Environment files
.env
.env.local
.env.*.local

# Documentation
*.md
LICENSE
CONTRIBUTING.md
DEVELOPERS.md
i18n/

# Static assets (unnecessary for builds)
static/

# Docker compose
docker/

# Per-service test directories (copied only when needed)
**/test/
**/tests/
